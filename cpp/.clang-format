---
Language: Cpp
BasedOnStyle: Google

IndentWidth: 4
TabWidth: 4
UseTab: Never

IndentAccessModifiers: false
AccessModifierOffset: -4

BreakBeforeBraces: Custom
BraceWrapping:
    BeforeElse: true


ColumnLimit: 100

# Keep the declaration following "template <...>" on a new line.
BreakTemplateDeclarations: Yes

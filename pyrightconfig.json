{
    "venvPath": "python",
    "venv": ".venv",
    "stubPath": "python/typings",
    "pythonVersion": "3.12",
    "typeCheckingMode": "standard",
    "include": [
        "python/src"
    ],
    "exclude": [
        "python/.venv",
        "python/src/train/experiments",
        "**/__pycache__"
    ],
    "executionEnvironments": [
        {
            "root" : "python",
            "extraPaths": [
                "python"
            ]
        }
    ]
}

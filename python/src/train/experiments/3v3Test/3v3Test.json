{
    "run_name"              : "3v3Test",
    "device"                : "auto",
    "model_name"            : "r_mappo_latest.pt",

    "number_of_agents"      : 3,
    "number_of_enemies"     : 3,
    "training_team_id"      : 0,
    "action_dimension"      : 5,
    
    "training": {
        "continue_training"     : false,
        "buffer_size"           : 6000,
        "mini_batch"            : 4,
        "episodes"              : 2,
        "number_of_environments": 1,
        "number_of_engines"     : 1,
        "save_every_x_episode"  : 1,
        "maximum_steps"         : 1000,
        "mappo": {
            "learning_rate": 1e-4,
            "gamma": 0.99
        }
    },

    "adapter": {
        "position_scale": 1000.0
    },

    "engine": {
        "mode": "training",
        "unit": "armpw",
        "spawn_spacing": 80,

        "ai_options": {
            "update_interval_frames": 2,
            "move_step_size": 100.0,
            "first_update_frame": 2
        }
    },

    "logging": {
        "level": "INFO",
        "modules": {
            "src.environment.bar_environment": "INFO",
            "src.environment.unit_data_memory": "INFO",
            "src.environment.engine_session": "INFO"
        }
    }

}
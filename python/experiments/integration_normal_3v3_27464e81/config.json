{
    "device": "cpu",
    "model_name": "r_mappo_latest.pt",
    "action_dimension": 5,
    "self_play": false,
    "reward": {
        "damage_enemy_coef": 0.02,
        "damage_own_coef": 0.02,
        "enemy_kill": 0.75,
        "own_death": 0.75,
        "win": 10.0,
        "loss": 10.0,
        "time_penalty": 0.001,
        "clip_min": -10.0,
        "clip_max": 10.0
    },
    "training": {
        "continue_training": false,
        "buffer_size": 4,
        "mini_batch": 1,
        "episodes": 1,
        "number_of_environments": 1,
        "number_of_engines": 1,
        "save_every_x_episode": 1,
        "maximum_steps": 2,
        "mappo": {
            "learning_rate": 0.0001,
            "gamma": 0.99
        }
    },
    "adapter": {
        "position_scale": 1000.0
    },
    "engine": {
        "mode": "training",
        "spawn_spacing": 80,
        "units": {
            "own": {
                "armpw": 3
            },
            "enemy": {
                "armpw": 3
            }
        },
        "ai_options": {
            "update_interval_frames": 2,
            "move_step_size": 100.0,
            "first_update_frame": 2
        }
    },
    "logging": {
        "level": "INFO",
        "modules": {
            "src.environment.bar_environment": "INFO",
            "src.environment.unit_data_memory": "INFO",
            "src.environment.engine_session": "INFO",
            "src.environment.grpc_server": "INFO"
        }
    }
}
<mxfile host="app.diagrams.net">
  <diagram name="MAPPO Trainingsablauf" id="mappo1">
    <mxGraphModel dx="1528" dy="811" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" value="&lt;b&gt;Komponentendiagramm – R-MAPPO Training (BAR 3v3)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="600" x="40" as="geometry" />
        </mxCell>
        <mxCell id="cfg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;3v3Test.json&lt;/b&gt;&lt;br&gt;Konfiguration&lt;br&gt;(Episoden, lr, gamma …)" vertex="1">
          <mxGeometry height="70" width="180" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="training" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;training.py&lt;/b&gt;&lt;br&gt;Steuert den gesamten Ablauf:&lt;br&gt;Episode spielen → Daten sammeln →&lt;br&gt;lernen → speichern" vertex="1">
          <mxGeometry height="100" width="360" x="380" y="40" as="geometry" />
        </mxCell>
        <mxCell id="env" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" value="&lt;b&gt;BAR_Environment + bar_ai&lt;/b&gt;&lt;br&gt;Spiel-Engine&amp;nbsp;" vertex="1">
          <mxGeometry height="80" width="240" x="940" y="50" as="geometry" />
        </mxCell>
        <mxCell id="ckpt" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Checkpoints (.pt)&lt;/b&gt;&lt;br&gt;gespeicherte Modelle" vertex="1">
          <mxGeometry height="70" width="180" x="40" y="160" as="geometry" />
        </mxCell>
        <mxCell id="obs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;obs_r_mappo.py&lt;/b&gt;&lt;br&gt;Wandelt Spielzustand in&lt;br&gt;Beobachtungen um:&lt;br&gt;eigene Einheit + 3 nächste Gegner" vertex="1">
          <mxGeometry height="130" width="200" x="40" y="270" as="geometry" />
        </mxCell>
        <mxCell id="buffer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;replay_buffer.py&lt;/b&gt;&lt;br&gt;SharedReplayBuffer&lt;br&gt;Speichert die Erfahrungen einer Episode, berechnet Returns/Advantages und liefert Mini-Batches" vertex="1">
          <mxGeometry height="130" width="200" x="300" y="270" as="geometry" />
        </mxCell>
        <mxCell id="trainer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;r_mappo.py&lt;/b&gt;&lt;br&gt;R_MAPPO (Trainer)&lt;br&gt;Lernschritt: verbessert Actor und Critic mit den Daten aus dem Buffer (PPO-Update)" vertex="1">
          <mxGeometry height="130" width="200" x="600" y="270" as="geometry" />
        </mxCell>
        <mxCell id="policy" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=45;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;policy.py – R_MAPPO_Policy&lt;/b&gt;&lt;br&gt;Das neuronale Netz (die „Strategie“)" vertex="1">
          <mxGeometry height="200" width="300" x="920" y="270" as="geometry">
            <mxRectangle height="45" width="230" x="920" y="270" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="actor" parent="policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Actor&lt;/b&gt;&lt;br&gt;wählt den Aktionstyp" vertex="1">
          <mxGeometry height="55" width="130" x="15" y="60" as="geometry" />
        </mxCell>
        <mxCell id="scorer" parent="policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;TargetScorer&lt;/b&gt;&lt;br&gt;wählt das Angriffsziel" vertex="1">
          <mxGeometry height="55" width="130" x="155" y="60" as="geometry" />
        </mxCell>
        <mxCell id="critic" parent="policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Critic&lt;/b&gt;&lt;br&gt;bewertet, wie gut der aktuelle Zustand ist" vertex="1">
          <mxGeometry height="55" width="270" x="15" y="130" as="geometry" />
        </mxCell>
        <mxCell id="args" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;trainerargs.py&lt;/b&gt;&lt;br&gt;PPO-Einstellungen" vertex="1">
          <mxGeometry height="60" width="150" x="530" y="480" as="geometry" />
        </mxCell>
        <mxCell id="utils" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;utils.py&lt;/b&gt;&lt;br&gt;Hilfsfunktionen (Loss, Normalisierung)" vertex="1">
          <mxGeometry height="60" width="170" x="720" y="480" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=8;" value="&lt;b&gt;Nicht Teil des Trainingsablaufs (siehe Text):&lt;/b&gt;&lt;br&gt;• reward.py – Belohnungsberechnung&lt;br&gt;• play_trained.py – fertiges Modell abspielen" vertex="1">
          <mxGeometry height="70" width="440" x="30" y="470" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="cfg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" target="training" value="Hyperparameter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="training" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;" target="env" value="reset() / step(Aktionen)&lt;br&gt;↔ Rohdaten, Reward, Ende">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="training" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" target="ckpt" value="Modell speichern">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="training" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="obs" value="Rohdaten → Beobachtungen&lt;br&gt;+ Ziel-Kandidaten">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="235" />
              <mxPoint x="140" y="235" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="training" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.76;entryY=0;entryDx=0;entryDy=0;" target="buffer" value="speichern, Returns berechnen,&lt;br&gt;leeren">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="training" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.89;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="trainer" value="train(buffer)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="training" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="policy" value="Aktionen sampeln&lt;br&gt;(Rollout)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="235" />
              <mxPoint x="1070" y="235" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="trainer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" target="buffer" value="Mini-Batches">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="trainer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" target="policy" value="Netz auswerten&lt;br&gt;+ Gewichte updaten">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="args" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" target="trainer" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="utils" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" target="trainer" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jkjWJtvwhJ_PHbQuvj52-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;b&gt;Begriffserklärungen:&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;&amp;nbsp;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Batch&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; ist eine Gruppe von Datenpunkten, die das Netz auf einmal verarbeitet. In deinem Fall besteht ein Datenpunkt aus einem Schritt einer Einheit mit Beobachtung, Aktion und Belohnung.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Nach einer Episode liegen im Buffer alle Schritte aller Agenten, etwa 3 Agenten mal Hunderte Schritte. Diese &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;gesamte Datenmenge&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt; ist der Batch.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;Rollout&lt;/strong&gt; heißt: Die Agenten spielen eine Episode, und du sammelst Daten, ohne dass das Netz dabei lernt.&lt;/p&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;Sampeln&lt;/strong&gt; heißt: Das Netz gibt keine feste Aktion aus, sondern Wahrscheinlichkeiten. Der Actor sagt zum Beispiel: 60 % Bewegen, 30 % Angreifen, 10 % etwas anderes. Dann wird zufällig nach diesen Wahrscheinlichkeiten gewürfelt.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="470" x="40" y="560" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
